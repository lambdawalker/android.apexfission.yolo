---
const route=Astro.locals.starlightRoute;
// Existing English URLs have no same-path locale mirrors. Keep all other head tags.
const localized=/^(en|es)(\/|$)/.test(route.id);
const head=route.head.filter(item=>localized||!(item.tag==='link'&&item.attrs?.rel==='alternate'));
---
{head.map(({tag: Tag,attrs,content})=><Tag {...attrs} set:html={content} />)}
